# Port the API listens on (defaults to 3000)
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=user_management

# true lets TypeORM create tables from the entities; keep false and use the migration instead
DB_SYNC=false
# true prints every SQL query TypeORM runs
DB_LOGGING=false

# Secret that signs the JWT access tokens; use a long random value
JWT_SECRET=YOUR_JWT_SECRET
